# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Flask session signing key. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Postgres + pgvector (docker-compose default)
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Optional. Redis is used only if you swap the in-process worker for RQ.
REDIS_URL=redis://localhost:6379/0

# Where uploaded files are stored (outside the web root)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Base URL used in the "connect your agent" snippets, e.g. https://rag.example.com
PUBLIC_BASE_URL=http://localhost:8000
MCP_PUBLIC_URL=http://localhost:8001/mcp

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# local  -> ONNX model on CPU, no API key, downloads once (~35 MB). Default.
# openai -> any OpenAI-compatible /embeddings endpoint
# hash   -> deterministic pseudo-embeddings, tests only
EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIM=384

# Required only when EMBEDDINGS_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# Chat / LLM (OpenAI-compatible)
# ---------------------------------------------------------------------------
# OpenRouter free tier works out of the box with the sibling project's key.
# OpenAI: https://api.openai.com/v1 + gpt-4o-mini
# Ollama: http://localhost:11434/v1 + llama3.1 (key can be anything)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
# LLM_API_KEY=            # used instead of OPENROUTER_API_KEY if set
# LLM_TIMEOUT=120
# LLM_MAX_TOKENS=1200
# AGENTIC_MAX_TOOL_CALLS=5

# ---------------------------------------------------------------------------
# Reranking (optional, on when a provider is configured)
# ---------------------------------------------------------------------------
# local  -> ONNX cross-encoder on CPU, no key
# cohere -> Cohere rerank API
# none   -> disable
RERANK_PROVIDER=local
# COHERE_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-base

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
FLASK_DEBUG=0
MCP_HOST=127.0.0.1
MCP_PORT=8001

# In-process ingestion worker (threads). Set to 0 to run `python -m ingestion.worker` separately.
WORKER_ENABLED=1
WORKER_CONCURRENCY=2
